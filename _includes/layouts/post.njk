---
layout: layouts/base.njk
---
<style>.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem; 
}

.image-grid img {
  width: 100%;
  height: 260px;
  object-fit: cover;
  border-radius: 8px; 
}
.image-grid figcaption {
  grid-column: 1 / -1; 
  margin-top: 0.5rem;
  font-size: 0.85rem;
  color: rgba(255,255,255,0.7);
  font-style: italic;
  text-align: center;
  margin-bottom: .7rem;
}</style>

<article>
  <h1>{{ title }}</h1>

  <div class="path">
    <a href="/terminal" class="path-root">root</a>/<a href="/">home</a>/<a href="/posts/">posts</a>/<span class="path-current">{{ page.fileSlug }}{{ file_ext or ".html" }}</span>
  </div>

  <div class="meta">
    <span class="date">{{ date | dateFormat }}</span>
    {% if updated %}
      <span class="date updated">Updated: {{ updated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) }}</span>
    {% endif %}
    {% if tags %}
    <div class="tags">
      {% for tag in tags %}
        {% if tag != "posts" %}
          <a href="#" class="tag">{{ tag }}</a>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </div>
  <aside class="toc">
    <span class="toc-title">Table of Contents</span>
    <ul id="toc-list"></ul>
  </aside>
  {{ content | safe }}
{# ── Post Navigation ── #}
{% set postList = collections.posts %}
{% set currentIndex = 0 %}
{% for p in postList %}
  {% if p.url == page.url %}
    {% set currentIndex = loop.index0 %}
  {% endif %}
{% endfor %}

{% set newerPost = postList[currentIndex - 1] if currentIndex > 0 else null %}
{% set olderPost = postList[currentIndex + 1] if currentIndex < (postList.length - 1) else null %}

<nav class="post-nav">
  <div class="post-nav-left">
    <a href="/posts/" class="post-nav-btn">← /Posts</a>
  </div>

  <div class="post-nav-right">
    {% if newerPost %}
      <a href="{{ newerPost.url }}" class="post-nav-btn">[Newer]</a>
    {% else %}
      <span class="post-nav-btn post-nav-disabled">← Newer</span>
    {% endif %}

    <span class="post-nav-divider">|</span>

    {% if olderPost %}
      <a href="{{ olderPost.url }}" class="post-nav-btn">[Older]</a>
    {% else %}
      <span class="post-nav-btn post-nav-disabled">Older →</span>
    {% endif %}
  </div>
</nav>
</article>

<script>
  const headings = document.querySelectorAll('main h2, main h3');
  const tocList = document.getElementById('toc-list');

  headings.forEach((heading, i) => {
    if (!heading.id) heading.id = 'heading-' + i;

    const li = document.createElement('li');
    li.classList.add('toc-' + heading.tagName.toLowerCase());

    const a = document.createElement('a');
    a.href = '#' + heading.id;
    a.textContent = heading.textContent;

    li.appendChild(a);
    tocList.appendChild(li);
  });
</script>