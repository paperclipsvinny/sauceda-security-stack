---
layout: layouts/base.njk
title: Posts
eleventyExcludeFromCollections: true
---

<h1>All Posts</h1>

<div style="margin-bottom: 3rem;">
  <div style="margin-bottom: 1.5rem;">
    <span style="font-size: 0.85rem; opacity: 0.7; margin-right: 0.5rem;">By tag:</span>
    <div class="tag-filter" style="display: inline-block;">
      <button data-filter="all" class="active">All</button>
      {% set allTags = [] %}
      {% for post in collections.posts %}
        {% if post.data.tags %}
          {% for tag in post.data.tags %}
            {% if tag != "posts" and tag not in allTags %}
              {% set allTags = (allTags.push(tag), allTags) %}
            {% endif %}
          {% endfor %}
        {% endif %}
      {% endfor %}
      {% for tag in allTags | sort %}
        <button data-filter="{{ tag }}">{{ tag }}</button>
      {% endfor %}
    </div>
  </div>

  <div>
    <span style="font-size: 0.85rem; opacity: 0.7; margin-right: 0.5rem;">By date:</span>
    <div class="date-sort" style="display: inline-block;">
      <button data-sort="newest" class="active">Newest First</button>
      <button data-sort="oldest">Oldest First</button>
    </div>
  </div>
</div>

<div id="posts-container">
  {% for post in collections.posts | sort(attribute="date") | reverse %}
    <article class="post-preview" 
             style="margin-top: 3rem; border-top: 1px solid rgba(255,255,255,0.15); padding-top: 2rem;"
             data-tags="{{ post.data.tags | join(',') }}"
             data-date="{{ post.data.date }}"
             data-title="{{ post.data.title }}">
      
      <h2>
        <a href="{{ post.url }}" style="color: inherit; text-decoration: none;">
          {{ post.data.title }}
        </a>
      </h2>

      <div class="meta">
        <span class="date">{{ post.data.date | dateFormat }}</span>
        {% if post.data.tags %}
          <div class="tags">
            {% for tag in post.data.tags %}
              {% if tag != "posts" %}
                <span class="tag">{{ tag }}</span>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>

      {% if post.data.summary %}
        <p>{{ post.data.summary }}</p>
      {% endif %}

    </article>
  {% endfor %}
</div>

<script>
  const tagButtons = document.querySelectorAll(".tag-filter button");
  const sortButtons = document.querySelectorAll(".date-sort button");
  const postsContainer = document.getElementById("posts-container");
  const posts = Array.from(document.querySelectorAll(".post-preview"));

  let currentFilter = "all";
  let currentSort = "newest";

  function updateDisplay() {
    // Filter posts
    const filteredPosts = posts.filter(post => {
      const tags = post.dataset.tags.split(",");
      return currentFilter === "all" || tags.includes(currentFilter);
    });

    // Sort posts
    filteredPosts.sort((a, b) => {
      const dateA = new Date(a.dataset.date);
      const dateB = new Date(b.dataset.date);
      return currentSort === "newest" ? dateB - dateA : dateA - dateB;
    });

    // Hide all posts
    posts.forEach(post => post.style.display = "none");

    // Show and reorder filtered posts
    filteredPosts.forEach(post => {
      post.style.display = "";
      postsContainer.appendChild(post);
    });
  }

  tagButtons.forEach(button => {
    button.addEventListener("click", () => {
      currentFilter = button.dataset.filter;
      tagButtons.forEach(b => b.classList.remove("active"));
      button.classList.add("active");
      updateDisplay();
    });
  });

  sortButtons.forEach(button => {
    button.addEventListener("click", () => {
      currentSort = button.dataset.sort;
      sortButtons.forEach(b => b.classList.remove("active"));
      button.classList.add("active");
      updateDisplay();
    });
  });
</script>

<style>
  .tag-filter button,
  .date-sort button {
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: var(--text-color);
    padding: 0.3rem 0.6rem;
    margin-right: 0.5rem;
    margin-bottom: 0.5rem;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.8rem;
  }

  .tag-filter button.active,
  .date-sort button.active {
    background-color: rgba(255, 255, 255, 0.15);
  }

  .tag-filter button:hover,
  .date-sort button:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }
</style>
