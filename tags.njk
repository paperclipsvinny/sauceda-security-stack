---
pagination:
  data: collections
  size: 1
  alias: tag
permalink: "tags/{{ tag }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "Posts tagged: {{ tag }}"
---

<h1>Tag: {{ tag }}</h1>

{% for post in collections[tag] | sort(attribute="date") | reverse %}
  {% if post.data.tags and "posts" in post.data.tags %}
    <article>
      <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
      <small>{{ post.date | dateFormat }}</small>
    </article>
  {% endif %}
{% endfor %}
